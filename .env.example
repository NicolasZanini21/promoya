# Supabase (dashboard del proyecto > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx

# Búsqueda web del job diario — gratis hasta 1000/mes: https://app.tavily.com
TAVILY_API_KEY=xxxxxxxx

# LLM que extrae los datos de la promo — gratis en Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxx

# Web Push (generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=xxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxx

# Secreto para proteger /api/cron/buscar-promos de llamadas externas
CRON_SECRET=cambiar-este-valor
